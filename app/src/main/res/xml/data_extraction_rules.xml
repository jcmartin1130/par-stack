<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: include the saved ledger in cloud backup and in phone-to-phone transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
